{
  "name": "iron-log",
  "version": "2.1.1",
  "private": true,
  "description": "Iron Log — workout logger (phone gym logger, desktop, web)",
  "author": "Alex",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "electron": "node scripts/run-electron.js .",
    "electron:dev": "node scripts/run-electron.js . --dev",
    "electron:build": "vite build && electron-builder --win --x64",
    "release": "npm run electron:build && node scripts/publish-release.js",
    "shots": "node scripts/run-electron.js scripts/screenshot.cjs",
    "icons": "node scripts/run-electron.js scripts/make-icons.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.alex.ironlog",
    "productName": "Iron Log",
    "copyright": "Copyright © 2026 Alex",
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Iron Log"
    },
    "publish": {
      "provider": "github",
      "owner": "alxkim97",
      "repo": "iron-log"
    }
  }
}
