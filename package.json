{
  "name": "iron-log",
  "version": "1.4.1",
  "description": "IRON LOG — Workout Session Logger",
  "main": "main.js",
  "author": "Alex",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.alex.ironlog",
    "productName": "Iron Log",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "vendor/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    }
  }
}
